generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  REJECTED
  CANCELLED
}

enum AdminRole {
  SUPERADMIN
  BOUTIQUE_ADMIN
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

model StoreType {
  id                  String    @id @default(cuid())
  key                 String    @unique
  label               String
  themeId             String?
  // Per-boutique contact/branding/storefront — each boutique has its own
  // public route (/{locale}/{key}), so everything a visitor sees (name,
  // announcement bar, hero, SEO, theme, payment numbers, logo) lives here
  // instead of on the StoreSettings singleton, which now only points at
  // the default boutique for "/" to redirect to.
  adminWhatsappNumber String?
  paymentInstructions String?
  logoStoragePath     String?
  siteName            String?
  announcementText    String?
  heroImagePath       String?
  heroImagePosition   String    @default("right")
  heroTitle           String?
  heroSubtitle        String?
  heroBadgeText       String?
  heroCtaLabel        String?
  seoTitle            String?
  seoDescription      String?
  // Arabic overrides for the handful of fields worth translating (name,
  // hero copy, SEO) — optional, fall back to the base (French) column above
  // when null. English reuses the base column too (no separate en field):
  // only fr/ar diverge, by explicit choice. Everything else on this model
  // (announcement bar, hero badge/CTA, payment info) stays single-language.
  siteNameAr          String?
  heroTitleAr         String?
  heroSubtitleAr      String?
  seoTitleAr          String?
  seoDescriptionAr    String?
  // Infrastructure-level, superadmin-only — never editable via
  // updateBoutiqueSettings/requireAdminScope like everything above. domain
  // lets proxy.ts route a custom hostname straight to this boutique with no
  // visible [storeType] segment (still needs the actual DNS/Vercel domain
  // setup done separately). licenseExpiresAt drives a purely visual
  // expiration warning (lib/shop/license.ts) — null means unrestricted,
  // nothing is ever blocked based on it.
  domain              String?   @unique
  licenseExpiresAt    DateTime?
  createdAt           DateTime  @default(now())

  categories     Category[]
  products       Product[]
  orders         Order[]
  sales          Sale[]
  clients        Client[]
  storeSettings  StoreSettings[]
  adminUsers     AdminUser[]
  socialLinks    SocialLink[]
  promoCodes     PromoCode[]
  walletAccounts WalletAccount[]
}

model SocialLink {
  id          String    @id @default(cuid())
  productType String
  storeType   StoreType @relation(fields: [productType], references: [key])
  platform    String
  url         String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([productType])
}

// Payment wallet numbers (Bankily, Masrivy, or any other provider the
// admin names) — a repeatable, ordered list (mirrors SocialLink) instead
// of two fixed StoreType columns. provider is free text, not an enum, so
// the admin isn't limited to a hardcoded set; logoStoragePath is an
// optional uploaded image (falls back to a generic icon when absent), both
// in the admin manager and at checkout.
model WalletAccount {
  id              String    @id @default(cuid())
  productType     String
  storeType       StoreType @relation(fields: [productType], references: [key])
  provider        String
  number          String
  logoStoragePath String?
  position        Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([productType])
}

// Links a Supabase auth user to a role. supabaseUserId is a plain string,
// not a real FK — auth.users lives in Supabase's own `auth` schema, out of
// Prisma's reach here (no multi-schema config). SUPERADMIN sees/manages
// every boutique; BOUTIQUE_ADMIN is permanently locked to one (enforced by
// the DB check below, and by lib/shop/admin-scope.ts ignoring the
// free-choice cookie for this role).
model AdminUser {
  id             String     @id @default(cuid())
  supabaseUserId String     @unique
  role           AdminRole
  productType    String?
  // Explicit Restrict (not Prisma's implicit SetNull default for an
  // optional relation) — matches the original migration's raw SQL and the
  // DB-level CHECK below: a BOUTIQUE_ADMIN's productType must never become
  // null, so deleting a boutique an admin is scoped to must fail loudly,
  // not silently orphan the check constraint.
  storeType      StoreType? @relation(fields: [productType], references: [key], onDelete: Restrict)
  createdAt      DateTime   @default(now())

  @@index([productType])
}

model Category {
  id          String     @id @default(cuid())
  // Not @unique here: uniqueness is enforced by two partial unique indexes
  // in the migration SQL instead (one per generic name, one per
  // (name, productType) pair) — Prisma's schema DSL can't express a
  // partial/filtered unique index, but the DB-level constraint still
  // applies and createCategory/updateCategory still catch its P2002.
  name        String
  // null = generic, shown regardless of the active store product type.
  // Set only on categories created by the type switch (setProductType) —
  // never backfilled on pre-existing categories, so nothing already in
  // use disappears from the picker.
  productType String?
  storeType   StoreType? @relation(fields: [productType], references: [key])
  products    Product[]
  createdAt   DateTime   @default(now())

  @@index([productType])
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String?
  basePrice      Decimal          @db.Decimal(10, 2)
  compareAtPrice Decimal?         @db.Decimal(10, 2)
  isFeatured     Boolean          @default(false)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  // Which boutique this product belongs to — set once at creation from the
  // admin's current scope (lib/shop/admin-scope.ts), never inferred from
  // Category (which stays nullable/generic for the category picker only).
  productType    String
  storeType      StoreType        @relation(fields: [productType], references: [key])
  images         ProductImage[]
  variants       ProductVariant[]
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([productType])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storagePath String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size              String
  color             String
  sku               String      @unique
  price             Decimal?    @db.Decimal(10, 2)
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  saleItems         SaleItem[]
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

model Client {
  id          String      @id @default(cuid())
  fullName    String
  phone       String?
  email       String?
  address     String?
  notes       String?
  // Which boutique this client belongs to — set at creation from the
  // admin's current scope. Sales only ever pick clients from the same
  // boutique (lib/actions/sales.ts).
  productType String
  storeType   StoreType   @relation(fields: [productType], references: [key])
  sales       Sale[]
  promoCodes  PromoCode[]
  createdAt   DateTime    @default(now())

  @@index([fullName])
  @@index([productType])
}

model Sale {
  id            String     @id @default(cuid())
  reference     String     @unique
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  items         SaleItem[]
  subtotal      Decimal    @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  total         Decimal    @db.Decimal(10, 2)
  status        SaleStatus @default(COMPLETED)
  paymentMethod String?
  notes         String?
  // Stamped at creation from the admin's current scope (manual sale) or
  // copied from the source Order (auto-created on deliverOrder).
  productType   String
  storeType     StoreType  @relation(fields: [productType], references: [key])
  createdAt     DateTime   @default(now())

  @@index([clientId])
  @@index([createdAt])
  @@index([productType])
}

model SaleItem {
  id        String         @id @default(cuid())
  saleId    String
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  lineTotal Decimal        @db.Decimal(10, 2)

  @@index([saleId])
  @@index([variantId])
}

model Order {
  id               String      @id @default(cuid())
  reference        String      @unique
  customerName     String
  customerPhone    String
  customerCity     String
  items            OrderItem[]
  subtotal         Decimal     @db.Decimal(10, 2)
  discount         Decimal     @default(0) @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  paymentProofPath String
  locale           String?
  // Re-validated from scratch inside submitOrder's transaction — never
  // trusts a client-computed discount amount. Null when no code was used.
  promoCodeId      String?
  promoCode        PromoCode?  @relation(fields: [promoCodeId], references: [id])
  // The boutique the checkout form was submitted from (its [storeType] URL
  // segment) — validated server-side against every variant in the cart
  // before being trusted (see submitOrder).
  productType      String
  storeType        StoreType   @relation(fields: [productType], references: [key])
  createdAt        DateTime    @default(now())
  confirmedAt      DateTime?
  rejectedAt       DateTime?
  rejectReason     String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  @@index([status])
  @@index([createdAt])
  @@index([productType])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  lineTotal Decimal        @db.Decimal(10, 2)

  @@index([orderId])
  @@index([variantId])
}

// Personal (clientId set — usable only by that client, matched by phone at
// checkout) or general (clientId null — usable by any customer) discount
// code. Limits are all optional and independently configurable: expiresAt
// null = never expires, maxUses null = unlimited (isActive is the only way
// to retire it). usedCount is incremented atomically inside submitOrder's
// transaction, never trusted from client input.
model PromoCode {
  id            String            @id @default(cuid())
  code          String            @unique
  discountType  PromoDiscountType
  discountValue Decimal           @db.Decimal(10, 2)
  clientId      String?
  client        Client?           @relation(fields: [clientId], references: [id])
  productType   String
  storeType     StoreType         @relation(fields: [productType], references: [key])
  expiresAt     DateTime?
  maxUses       Int?
  usedCount     Int               @default(0)
  isActive      Boolean           @default(true)
  orders        Order[]
  createdAt     DateTime          @default(now())

  @@index([productType])
  @@index([clientId])
}

// Sliding-window rate limiting: one row per request that counted against a
// key (e.g. "order:<ip>"). checkRateLimit() (lib/rate-limit.ts) counts rows
// newer than the window and prunes older ones on every call.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Every visible storefront concern (name, hero, SEO, theme, announcement)
// now lives on StoreType, one row per boutique with its own public route.
// This singleton keeps a single job: which boutique "/" redirects to.
model StoreSettings {
  id          String    @id @default("singleton")
  productType String    @default("sport")
  storeType   StoreType @relation(fields: [productType], references: [key])
  updatedAt   DateTime  @updatedAt
}
