generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  REJECTED
  CANCELLED
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  // null = generic, shown regardless of the active store product type.
  // Set only on categories created by the type switch (setProductType) —
  // never backfilled on pre-existing categories, so nothing already in
  // use disappears from the picker.
  productType String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String?
  basePrice      Decimal          @db.Decimal(10, 2)
  compareAtPrice Decimal?         @db.Decimal(10, 2)
  isFeatured     Boolean          @default(false)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storagePath String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size              String
  color             String
  sku               String      @unique
  price             Decimal?    @db.Decimal(10, 2)
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  saleItems         SaleItem[]
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

model Client {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  address   String?
  notes     String?
  sales     Sale[]
  createdAt DateTime @default(now())

  @@index([fullName])
}

model Sale {
  id            String     @id @default(cuid())
  reference     String     @unique
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  items         SaleItem[]
  subtotal      Decimal    @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  total         Decimal    @db.Decimal(10, 2)
  status        SaleStatus @default(COMPLETED)
  paymentMethod String?
  notes         String?
  createdAt     DateTime   @default(now())

  @@index([clientId])
  @@index([createdAt])
}

model SaleItem {
  id        String         @id @default(cuid())
  saleId    String
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  lineTotal Decimal        @db.Decimal(10, 2)

  @@index([saleId])
  @@index([variantId])
}

model Order {
  id               String      @id @default(cuid())
  reference        String      @unique
  customerName     String
  customerPhone    String
  customerCity     String
  items            OrderItem[]
  subtotal         Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  paymentProofPath String
  locale           String?
  createdAt        DateTime    @default(now())
  confirmedAt      DateTime?
  rejectedAt       DateTime?
  rejectReason     String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  lineTotal Decimal        @db.Decimal(10, 2)

  @@index([orderId])
  @@index([variantId])
}

// Sliding-window rate limiting: one row per request that counted against a
// key (e.g. "order:<ip>"). checkRateLimit() (lib/rate-limit.ts) counts rows
// newer than the window and prunes older ones on every call.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model StoreSettings {
  id                  String   @id @default("singleton")
  bankilyNumber       String?
  masrivyNumber       String?
  adminWhatsappNumber String?
  paymentInstructions String?
  siteName            String?
  logoStoragePath     String?
  announcementText    String?
  heroImagePath       String?
  heroImagePosition   String   @default("right")
  heroTitle           String?
  heroSubtitle        String?
  heroBadgeText       String?
  heroCtaLabel        String?
  seoTitle            String?
  seoDescription      String?
  instagramUrl        String?
  facebookUrl         String?
  tiktokUrl           String?
  themeId             String   @default("default")
  productType         String   @default("sport")
  updatedAt           DateTime @updatedAt
}
