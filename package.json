{
  "name": "solelrim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && prisma migrate deploy && vite build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "setup:supabase": "tsx --conditions=react-server scripts/setup-supabase.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-direction": "^1.1.2",
    "@sentry/tanstackstart-react": "^11.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@vercel/functions": "^3.10.1",
    "@vercel/og": "0.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "4.14.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.13.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.0"
  }
}
