# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> Database for connection strings, Project Settings -> API for keys).

# Pooled connection (Supavisor, port 6543) — used by Prisma Client at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used only by the Prisma CLI for migrate/introspect.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Server-only — never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Canonical domain used by sitemap.ts/robots.ts. Optional — on Vercel this
# falls back to the project's production domain automatically; only needed
# for a custom domain or local testing of the sitemap.
# NEXT_PUBLIC_SITE_URL="https://solelrim.example.com"

# Error monitoring (instrumentation.ts / instrumentation-client.ts). From
# your Sentry project's Settings -> Client Keys (DSN). Optional — without
# it, Sentry.init() runs with dsn: undefined and silently does nothing.
# NEXT_PUBLIC_SENTRY_DSN="https://<public-key>@o<org-id>.ingest.<region>.sentry.io/<project-id>"

# Push notifications to the mobile app (lib/push/order-push.ts). Optional:
# without it pushes still go out through Expo's public endpoint. Set it if you
# turn on "Enhanced Push Security" for the project in the Expo dashboard.
# EXPO_ACCESS_TOKEN="..."

# Optional. Oldest mobile app version the API still serves (/api/v1): an app
# sending an older X-App-Version gets 426 appUpdateRequired. Unset = no check.
# APP_MIN_VERSION="1.4.0"

# Required for the daily cron (vercel.json) that cancels expired PENDING orders
# in boutiques that turned it on. Vercel sends it as "Authorization: Bearer ...";
# without it the cron route refuses every call.
# CRON_SECRET="a long random string"
